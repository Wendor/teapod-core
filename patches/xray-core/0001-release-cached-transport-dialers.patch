--- a/transport/internet/splithttp/dialer.go	2026-11-05 04:52:07.147545860 +0700
+++ b/transport/internet/splithttp/dialer.go	2026-11-05 21:07:42.790251999 +0700
@@ -318,6 +318,24 @@
 
 func init() {
 	common.Must(internet.RegisterTransportDialer(protocolName, Dial))
+	internet.RegisterStreamReleaser(releaseDialers)
+}
+
+// releaseDialers drops XMUX managers of a closed outbound (including its
+// downloadSettings); connections close once their running requests finish.
+func releaseDialers(streamSettings *internet.MemoryStreamConfig) {
+	globalDialerAccess.Lock()
+	defer globalDialerAccess.Unlock()
+	for key, manager := range globalDialerMap {
+		if key.MemoryStreamConfig != streamSettings && key.MemoryStreamConfig != streamSettings.DownloadSettings {
+			continue
+		}
+		for _, xmuxClient := range manager.xmuxClients {
+			xmuxClient.NotUsed.Store(true)
+			xmuxClient.maybeClose()
+		}
+		delete(globalDialerMap, key)
+	}
 }
 
