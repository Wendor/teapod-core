--- a/transport/internet/splithttp/release_test.go	1970-01-01 07:00:00.000000000 +0700
+++ b/transport/internet/splithttp/release_test.go	2026-11-05 21:08:20.940129653 +0700
@@ -0,0 +1,61 @@
+package splithttp
+
+import (
+	"context"
+	"testing"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+type closeTracker struct{ closed bool }
+
+func (c *closeTracker) IsClosed() bool { return c.closed }
+func (c *closeTracker) Close() error   { c.closed = true; return nil }
+
+func TestReleaseStreamSettingsClosesOnlyOwnDialers(t *testing.T) {
+	own := &internet.MemoryStreamConfig{}
+	own.DownloadSettings = &internet.MemoryStreamConfig{}
+	other := &internet.MemoryStreamConfig{}
+	dest := net.TCPDestination(net.LocalHostIP, 443)
+
+	newClient := func(conn *closeTracker) (*XmuxManager, *XmuxClient) {
+		m := NewXmuxManager(XmuxConfig{}, func() XmuxConn { return conn })
+		return m, m.GetXmuxClient(context.Background())
+	}
+	idle, busy, download, foreign := &closeTracker{}, &closeTracker{}, &closeTracker{}, &closeTracker{}
+	idleManager, _ := newClient(idle)
+	busyManager, busyClient := newClient(busy)
+	downloadManager, _ := newClient(download)
+	foreignManager, _ := newClient(foreign)
+	busyClient.AddRunning()
+
+	ownBusy := &internet.MemoryStreamConfig{DownloadSettings: own.DownloadSettings}
+	globalDialerAccess.Lock()
+	globalDialerMap = map[dialerConf]*XmuxManager{
+		{dest, own}:                  idleManager,
+		{dest, own.DownloadSettings}: downloadManager,
+		{dest, other}:                foreignManager,
+	}
+	globalDialerAccess.Unlock()
+	internet.ReleaseStreamSettings(own)
+
+	if !idle.closed || !download.closed {
+		t.Fatal("dialers of the released outbound must be closed")
+	}
+	if foreign.closed || len(globalDialerMap) != 1 {
+		t.Fatal("dialers of other outbounds must stay")
+	}
+
+	globalDialerAccess.Lock()
+	globalDialerMap[dialerConf{dest, ownBusy}] = busyManager
+	globalDialerAccess.Unlock()
+	internet.ReleaseStreamSettings(ownBusy)
+	if busy.closed {
+		t.Fatal("connection with a running request must not be closed")
+	}
+	busyClient.DoneRunning()
+	if !busy.closed {
+		t.Fatal("connection must close after its last request")
+	}
+}
