diff --color -ruN a/transport/internet/release.go b/transport/internet/release.go
--- a/transport/internet/release.go	1970-01-01 07:00:00.000000000 +0700
+++ b/transport/internet/release.go	2026-11-05 21:07:42.571442693 +0700
@@ -0,0 +1,29 @@
+package internet
+
+import "sync"
+
+var (
+	streamReleasersAccess sync.RWMutex
+	streamReleasers       []func(*MemoryStreamConfig)
+)
+
+// RegisterStreamReleaser registers a transport hook that drops connections the
+// transport caches globally per stream settings (e.g. XHTTP, gRPC).
+func RegisterStreamReleaser(release func(*MemoryStreamConfig)) {
+	streamReleasersAccess.Lock()
+	defer streamReleasersAccess.Unlock()
+	streamReleasers = append(streamReleasers, release)
+}
+
+// ReleaseStreamSettings closes cached connections bound to streamSettings of a
+// closed outbound. Without it they outlive the instance and keep alive forever.
+func ReleaseStreamSettings(streamSettings *MemoryStreamConfig) {
+	if streamSettings == nil {
+		return
+	}
+	streamReleasersAccess.RLock()
+	defer streamReleasersAccess.RUnlock()
+	for _, release := range streamReleasers {
+		release(streamSettings)
+	}
+}
